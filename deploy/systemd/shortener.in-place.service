# Transitional unit for the current in-place checkout. Prefer shortener.service
# after moving releases to /opt/shortener and state to /var/lib/shortener.
[Unit]
Description=C URL Shortener Service
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=micu
Group=micu
WorkingDirectory=/home/micu/trying_c
EnvironmentFile=/etc/shortener/shortener.env
ExecStart=/home/micu/trying_c/bin/shortener
Restart=on-failure
RestartSec=5s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=no
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictNamespaces=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
